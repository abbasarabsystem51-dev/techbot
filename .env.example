# ============================================================
# TechBot — Environment Variables Example
# Copy this file to .env and fill in your real values.
# Never commit the actual .env file to version control.
# ============================================================

# ---- Gemini API ----
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Telegram ----
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Numeric channel ID (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=-1001234567890

# ---- Eitaa ----
# Bot token from @eitaabot
EITAA_BOT_TOKEN=your_eitaa_bot_token_here
# Channel username (without @) or numeric ID
EITAA_CHANNEL_ID=your_eitaa_channel_id_here

# ---- Runtime paths (override defaults from config.yaml if needed) ----
# TECHBOT_DB_PATH=data/techbot.sqlite
# TECHBOT_LOG_LEVEL=INFO
